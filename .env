# 服务配置
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# 安全配置 (Bcrypt 限制明文密码必须小于 72 字节)
# ⚠️ 注意：INITIAL_ADMIN_PASSWORD 长度切勿超过 72 位，否则初始化会失败
INITIAL_ADMIN_PASSWORD=YourSecurePassword123!
JWT_SECRET_KEY=super-secret-key-change-me-in-production
OAUTH_REDIRECT_URI_WHITELIST_JSON='{"your_client_id":["http://127.0.0.1:8765/callback","https://your.app/callback"]}'

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./onauth.db